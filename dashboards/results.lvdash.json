{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(*) FROM evidence_runs) AS runs,\n",
        "  (SELECT count_if(result_state = 'FAILED') FROM evidence_runs) AS failed_runs,\n",
        "  count(*) AS rounds,\n",
        "  count_if(applied) AS patches_applied,\n",
        "  count_if(outcome = 'SUCCESS') AS patches_verified,\n",
        "  CAST(median(diagnosis_s) AS INT) AS median_diagnosis_s\n",
        "FROM evidence_rounds"
      ]
    },
    {
      "name": "runs_by_job",
      "displayName": "Runs by job",
      "queryLines": [
        "SELECT job_name, result_state, count(*) AS runs FROM evidence_runs GROUP BY ALL"
      ]
    },
    {
      "name": "rounds_by_category",
      "displayName": "Diagnoses by category",
      "queryLines": [
        "SELECT category, count(*) AS rounds FROM evidence_rounds GROUP BY ALL"
      ]
    },
    {
      "name": "diagnosis_time",
      "displayName": "Diagnosis time",
      "queryLines": [
        "-- One bar per round. The label starts with the date so the alphabetical axis is chronological.\n",
        "SELECT concat(date_format(started, 'MM-dd HH:mm'), ' ', coalesce(scenario, 'unknown')) AS round, category, diagnosis_s\n",
        "FROM evidence_rounds\n",
        "WHERE diagnosis_s IS NOT NULL"
      ]
    }
  ],
  "pages": [
    {
