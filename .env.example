# Copy to .env and fill in. .env is gitignored; this template is not.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Workspace path of the Git folder the jobs run from, e.g. /Workspace/Users/<you>/self-healing-databricks-pipeline-multi-agent
DATABRICKS_GIT_FOLDER=
# SQL warehouse id for get_table_lineage (SQL Warehouses > your warehouse > Overview)
DATABRICKS_WAREHOUSE_ID=
